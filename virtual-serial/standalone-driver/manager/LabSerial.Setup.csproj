<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LabSerial.Setup</AssemblyName>
    <RootNamespace>LabSerial.Setup</RootNamespace>
    <Version>0.1.2</Version>
    <Authors>LabSerial Development</Authors>
    <Description>Experimental LabSerial Windows device and diagnostics manager</Description>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\physical\Run-LabSerialCompatibilityBounded.ps1" Link="Scripts\Run-LabSerialCompatibilityBounded.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="..\physical\Test-LabSerialSerialPort.ps1" Link="Scripts\Test-LabSerialSerialPort.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="..\physical\Run-LabSerialEvidenceBounded.ps1" Link="Scripts\Run-LabSerialEvidenceBounded.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="..\physical\Evidence-LabSerialTransfer.ps1" Link="Scripts\Evidence-LabSerialTransfer.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="..\physical\LabSerialNativeProbe.cs" Link="Scripts\LabSerialNativeProbe.cs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="Run-LabSerialProfileProbe.ps1" Link="Scripts\Run-LabSerialProfileProbe.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
